<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tela de abertura do Android 12+: a flor no fundo creme, sem salto até a primeira tela. -->
    <style name="Theme.SunBi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/ic_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
    <!-- Modo launcher: mostra o papel de parede atrás da tela inicial -->
    <style name="Theme.SunBi.Launcher" parent="Theme.SunBi">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
