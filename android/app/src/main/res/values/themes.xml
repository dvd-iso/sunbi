<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SunBi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="bg">#FFFFF8F2</color>
    <color name="ic_bg">#FFFFF4D6</color>
    <!-- Modo launcher: mostra o papel de parede atrás da tela inicial -->
    <style name="Theme.SunBi.Launcher" parent="Theme.SunBi">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
