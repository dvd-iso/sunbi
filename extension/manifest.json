{
  "manifest_version": 3,
  "name": "SunBi",
  "description": "Sua rotina do SunBi no computador: a tarefa da vez, avisos na hora certa e tudo sincronizado com o celular.",
  "version": "1.0.0",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "SunBi",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications"],
  "host_permissions": ["http://*/*"],
  "browser_specific_settings": {
    "gecko": { "id": "sunbi@dvd-iso.github.io", "strict_min_version": "128.0" }
  }
}
